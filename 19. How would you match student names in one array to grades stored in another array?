import java.util.Scanner;

public class Number19 {
    public static void main(String[] args) {
        String[] students = {"Mariel", "John", "Justine", "Noel"};
        int[] grades = {83, 77, 91, 95};
        
        Scanner sc = new Scanner(System.in);
        
        // Show all students
        System.out.println("All students and grades:");
        for (int i = 0; i < students.length; i++) {
            System.out.println(students[i] + ": " + grades[i]);
        }
        
        // Search for student
        System.out.print("\nSearch for student: ");
        String name = sc.nextLine();
        
        int studentGrade = -1;
        for (int i = 0; i < students.length; i++) {
            if (students[i].equalsIgnoreCase(name)) {
                studentGrade = grades[i];
                break;
            }
        }
        
        // Show result
        if (studentGrade != -1) {
            System.out.println(name + "'s grade is: " + studentGrade);
        } else {
            System.out.println("Student not found.");
        }
        
        sc.close();
    }
}
